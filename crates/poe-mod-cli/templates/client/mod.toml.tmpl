# {{name}}: a client mod for the PoE2 private-server project. Spec:
# https://github.com/WaystoneWorks/Poe2ClientHook/blob/main/docs/mod-manifest.md
#
# manifest_version 1 is read by every launcher and client hook; a client mod only needs 2 when it
# uses the v2 sections. Pack it with `poe-mod pack` (see README.md).
manifest_version = 1
id = "{{id}}"
name = "{{name}}"
version = "0.1.0"
description = "A client mod that logs a hello line."
authors = ["{{author}}"]
license = "MIT"

[game]
versions = ["{{game_version}}"]
# The client mod ABI this mod is built against (poe_mod_sdk::client::HOOK_API_VERSION).
hook_api = {{hook_api}}

[entry]
dll = "client/{{lib}}.dll"
